# ShieldCaptcha v2 环境配置
# 复制此文件为 .env 并修改配置
# 生成密钥: openssl rand -hex 32

# ==================== 核心配置 ====================
CAPTCHA_HMAC_SECRET=
CAPTCHA_PORT=8080
CAPTCHA_BASE_DIFFICULTY=18
CAPTCHA_MIN_DIFFICULTY=16
CAPTCHA_MAX_DIFFICULTY=24
CAPTCHA_CHALLENGE_TTL=120s
CAPTCHA_RATE_LIMIT=10
CAPTCHA_RATE_BURST=20
CAPTCHA_NONCE_EXPIRY=300s
CAPTCHA_LOG_LEVEL=info

# ==================== Redis ====================
CAPTCHA_ENABLE_REDIS=true
CAPTCHA_REDIS_URL=redis://localhost:6379/0
CAPTCHA_REDIS_PREFIX=sc:

# ==================== PostgreSQL ====================
CAPTCHA_ENABLE_POSTGRES=true
CAPTCHA_POSTGRES_URL=postgres://captcha:captcha_dev_pass@localhost:5432/shieldcaptcha?sslmode=disable
CAPTCHA_AUTO_MIGRATE=true

# ==================== 管理面板 ====================
CAPTCHA_ADMIN_ENABLED=true
CAPTCHA_ADMIN_USER=admin
CAPTCHA_ADMIN_PASS=admin123
CAPTCHA_JWT_SECRET=change-me-in-production

# ==================== Feature Flags ====================
# 建议迁移时先全部设为 false，逐步开启
CAPTCHA_FEATURE_RISK_ENGINE=false
CAPTCHA_FEATURE_BEHAVIOR=false
CAPTCHA_FEATURE_ADAPTIVE_RATE=false
CAPTCHA_FEATURE_REPLAY_DETECT=false

# ==================== 监控 ====================
CAPTCHA_METRICS_ENABLED=true

# ==================== Docker Compose ====================
PG_PASSWORD=captcha_dev_pass
ADMIN_USER=admin
ADMIN_PASS=admin123
JWT_SECRET=change-me-in-production
GRAFANA_PASS=admin123
