# ShieldCaptcha 环境配置
# 复制此文件为 .env 并修改配置

# HMAC签名密钥 (64字符hex字符串, 即32字节)
# 生成方式: openssl rand -hex 32
CAPTCHA_HMAC_SECRET=

# 服务端口
CAPTCHA_PORT=8080

# PoW难度配置 (bit数)
CAPTCHA_BASE_DIFFICULTY=18
CAPTCHA_MIN_DIFFICULTY=16
CAPTCHA_MAX_DIFFICULTY=24

# 质询有效期
CAPTCHA_CHALLENGE_TTL=120s

# 限流配置 (每秒请求数/突发容量)
CAPTCHA_RATE_LIMIT=10
CAPTCHA_RATE_BURST=20

# Nonce过期时间 (防重放窗口)
CAPTCHA_NONCE_EXPIRY=300s

# 日志级别: trace, debug, info, warn, error
CAPTCHA_LOG_LEVEL=info
