{
  "annotations": { "list": [] },
  "panels": [
    {
      "title": "请求量 (QPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(shieldcaptcha_http_requests_total[5m])",
          "legendFormat": "{{method}} {{path}} {{status}}"
        }
      ]
    },
    {
      "title": "验证结果分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(shieldcaptcha_verifications_total[5m])",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "title": "验证延迟 (P95/P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(shieldcaptcha_verification_duration_seconds_bucket[5m]))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(shieldcaptcha_verification_duration_seconds_bucket[5m]))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "title": "风险评分分布",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(shieldcaptcha_risk_score_bucket[5m])",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "title": "速率限制命中",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(shieldcaptcha_rate_limit_hits_total[5m])",
          "legendFormat": "{{dimension}}"
        }
      ]
    },
    {
      "title": "活跃会话 / 已加载规则",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "shieldcaptcha_active_sessions", "legendFormat": "活跃会话" },
        { "expr": "shieldcaptcha_rules_loaded", "legendFormat": "规则数" }
      ]
    }
  ],
  "title": "ShieldCaptcha 总览",
  "uid": "shieldcaptcha-overview",
  "schemaVersion": 38,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "10s"
}
